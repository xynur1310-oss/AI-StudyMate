# GEMINI_API_KEY: Required for Gemini AI API calls.
# In Vercel, configure this in Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Optional secret string for encrypting stateless quiz session tokens across Vercel serverless instances.
# Defaults to GEMINI_API_KEY if not specified.
SESSION_SECRET="your_custom_secret_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

